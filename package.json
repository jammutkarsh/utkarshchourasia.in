{
  "name": "utkarshchourasia.in",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && node scripts/export-routes.mjs",
    "serve": "wrangler dev --config deploy/wrangler.jsonc",
    "deploy": "bun run build && wrangler deploy --config deploy/wrangler.jsonc",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.14",
    "classnames": "2.5.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "gsap": "3.13.0",
    "husky": "9.1.7",
    "lenis": "^1.2.3",
    "lint-staged": "16.4.0",
    "mermaid": "^11.17.2",
    "motion": "12.23.24",
    "next": "16.3.6",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "postcss": "8.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "reading-time": "^1.5.0",
    "tailwindcss": "^4.0.15",
    "typescript": "5.9.3",
    "use-breakpoint": "4.0.10",
    "vinext": "^1.2.1"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@mdx-js/rollup": "^3.1.1",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "oxc-transform-react": "^0.155.0",
    "vite": "8.3.0",
    "wrangler": "^4.151.3"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
