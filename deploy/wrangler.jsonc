{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "utkarshchourasia-in",
  "compatibility_date": "2026-10-20",
  // Static assets only: `vite build` exports the whole site to dist/client.
  // Kept outside the project root so vinext doesn't treat the site as a
  // Worker app.
  "assets": {
    "directory": "../dist/client",
    "not_found_handling": "404-page"
  },
  // Production domain. www -> apex is a Cloudflare redirect rule on the zone.
  "routes": [{ "pattern": "utkarshchourasia.in", "custom_domain": true }],
  // Keep the workers.dev URL too; pages' canonical links point at the domain.
  "workers_dev": true
}
